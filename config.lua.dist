-- Brasilia time
timeGMT = -3*60*60
-- Can only login who is adm or has no free pass
maintenance = false

showPackets = false

-- Combat settings--
-- NOTE: valid values for worldType are: "pvp", "no-pvp" and "pvp-enforced"
worldType = "retro-pvp"
hotkeyAimbotEnabled = true
protectionLevel = 7
pzLocked = 60 * 1000
removeChargesFromRunes = false
removeChargesFromPotions = true
removeWeaponAmmunition = false
removeWeaponCharges = false
-- default: 45 * 24 * 60 * 60 = 45 days
-- using 14hrs
timeToDecreaseFrags = 7 * 60 * 60
whiteSkullTime = 10 * 60 * 1000
stairJumpExhaustion = 1 * 1000
experienceByKillingPlayers = false
expFromPlayersLevelRange = 75
dayKillsToRedSkull = 5
weekKillsToRedSkull = 15
monthKillsToRedSkull = 30
redSkullDuration = 2
blackSkullDuration = 3
orangeSkullDuration = 3
blessRune = false

-- Reset System
resetLevel = 510 -- min level to reset
resetStatBonus = 20 -- % bonus for HP and MP calculation (example: level 8 with +2% = hp 185, mp 90)     
resetDmgBonus = 0 -- damage bonus per reset for the new system
resetNewLevel = 8 -- level after reset

-- Reset Skill Bonus Configuration
resetSorcererMagLevel = 10 -- magic level bonus for Sorcerer after reset
resetDruidMagLevel = 10 -- magic level bonus for Druid after reset
resetPaladinDistance = 10 -- distance skill bonus for Paladin after reset
resetPaladinMagLevel = 3 -- magic level bonus for Paladin after reset
resetKnightSword = 10 -- sword skill bonus for Knight after reset
resetKnightAxe = 10 -- axe skill bonus for Knight after reset
resetKnightClub = 10 -- club skill bonus for Knight after reset
resetKnightFist = 10 -- fist skill bonus for Knight after reset

-- PvP Protection Level
-- NOTE: Players with level 50 or below are protected from unjustified PvP
pvpProtectionLevel = 50

-- Same IP PvP Block
-- NOTE: If true, players with the same IP cannot attack each other or gain skulls
-- NOTE: If false, players with the same IP can attack each other normally
blockSameIpPvp = false

-- Connection Config
-- NOTE: maxPlayers set to 0 means no limit
-- NOTE: MaxPacketsPerSeconds if you change you will be subject to bugs by WPE, keep the default value of 25
-- NOTE: loginIp is only for the site
ip = "127.0.0.1"
loginIp = "127.0.0.1"
bindOnlyGlobalAddress = false
loginProtocolPort = 7171
gameProtocolPort = 7172
statusProtocolPort = 7171
maxPlayers = 0
motd = "Bem vindo ao Dragon Souls Server"
onePlayerOnlinePerAccount = true
allowClones = false
serverName = "Dragon Souls Server"
statusTimeout = 0
replaceKickOnLogin = true
maxPacketsPerSecond = 50
enableLiveCasting = true
liveCastPort = 7173
maxItem = 2000
maxContainer = 100
networkAttackThreshold = 50
replayProtocolPort = 7174

-- Sistema de "spoof" que simula a quantidade de players online ao longo do dia.
-- Observação: é apenas cosmético; não cria personagens de verdade e não afeta o gameplay.
-- Quando há muitos players reais conectados, o alvo de spoof é reduzido automaticamente (veja game.cpp: updateSpoofPlayers).
-- spoofEnabled = false                    -- Habilita/desabilita o sistema de spoof (true = ligado, false = desligado)
-- spoofDailyMinPlayers = 1               -- Mínimo de players simulados (base diária). Ex.: 1–100. Usado como base da curva diária
-- spoofDailyMaxPlayers = 100             -- Máximo de players simulados (pico diário). Deve ser maior que o mínimo
-- spoofNoiseInterval = 1000              -- Intervalo (ms) para recalcular o ruído aleatório. Ex.: 60000–600000 (1–10 min)
-- spoofNoise = 0                         -- Intensidade do ruído aleatório (±). Ex.: 0–50. 0 desliga o ruído; 10 adiciona ±10 players
-- spoofTimezone = -1                     -- Fuso horário (em horas) para deslocar a curva diária. Brasil ≈ -3; 0 = UTC
-- spoofInterval = 30000                  -- Intervalo (ms) entre atualizações do valor mostrado. Ex.: 30000–60000 (30–60 s)
-- spoofChangeChance = 70                 -- Chance (%) de ocorrer mudança a cada atualização. 0–100. 100 = sempre muda
-- spoofIncrementChange = 5               -- Controla tendência de diminuir em vez de aumentar. Quanto MAIOR, mais chance de diminuir (1 = quase sempre aumenta)

-- NOTE: Not is configured the ips
proxyList = "1,0.0.0.0,7000,USA;2,0.0.0.0,7000,BRA"

-- Version Manual
clientVersionMin = 1100
clientVersionMax = 1291
clientVersionStr = "Only support outdated 10.00 and version 12.91"

-- Anti Multi-Client System
antiMultiClientEnabled = true
antiMultiClientLimit = 2

-- Auto Loot Configuration
-- NOTE: autolootmode values:
-- 0 = disabled
-- 1 = enabled (items go to player inventory)
-- 2 = enabled (items go to backpack)
autolootmode = 2
vip_autoloot = 25
free_autoloot = 15

-- Configuração para permitir mount em Protection Zone (PZ)
-- true = permite mount em PZ
-- false = não permite mount em PZ (comportamento padrão)
allowMountInPz = true 

-- Depot Limit
freeDepotLimit = 2000
premiumDepotLimit = 10000
depotBoxes = 18

-- Max players allowed on a dummy.
maxAllowedOnADummy = 5
rateExerciseTrainingSpeed = 1

-- GameStore
gamestoreByModules = false

-- Expert Pvp Config
expertPvp = true

-- Quest Sytem
loadQuestLua = true

-- Deaths
-- NOTE: Leave deathLosePercent as -1 if you want to use the default
-- death penalty formula. For the old formula, set it to 10. For
-- no skill/experience loss, set it to 0.
deathLosePercent = -1

-- Houses
-- NOTE: set housePriceEachSQM to -1 to disable the ingame buy house functionality
housePriceEachSQM = 10000
houseRentPeriod = "never"

-- Item Usage
-- Do not touch here
timeBetweenActions = 500
timeBetweenExActions = 800
maxStack = 1000

-- Controle do cancelamento de push durante spells/poções
-- true: não cancelar push ao usar spells/runes/poções
-- false: comportamento padrão (cancela push)
disablePushCancelOnSpells = true

-- Push Mechanics
-- NOTE: pushDelay: interval for every adjacent push (in milliseconds)
-- NOTE: pushDistanceDelay: delay for every distance push (in milliseconds)
-- NOTE: pushWhenAttacking: true = enable push during attack, false = disable push during attack
pushDelay = 1000
pushDistanceDelay = 1500
pushWhenAttacking = false

-- Map
-- NOTE: set mapName WITHOUT .otbm at the end
-- NOTE: unzip the map world.rar
mapName = "dragon1098"
mapAuthor = ""

-- Market
marketOfferDuration = 30 * 24 * 60 * 60
premiumToCreateMarketOffer = true
checkExpiredMarketOffersEachMinutes = 60
maxMarketOffersAtATimePerPlayer = 100

-- MySQL
mysqlHost = "127.0.0.1"
mysqlUser = "forgottenserver"
mysqlPass = ""
mysqlDatabase = "forgottenserver"
mysqlPort = 3306
mysqlSock = ""
passwordType = "sha1"

-- Misc.
allowChangeOutfit = true
freePremium = true
kickIdlePlayerAfterMinutes = 15
idleWarningTime = 10 * 60 * 1000
idleKickTime = 15 * 60 * 1000
maxMessageBuffer = 4
emoteSpells = true
classicEquipmentSlots = false
allowWalkthrough = true
storeCoinsPacketSize = 25
storeImagesUrl = "http://localhost/store/"
defaultStoreOffer = "Blessings"
classicAttackSpeed = true
showScriptsLogInConsole = false
forceMonsterTypesOnLoad = true
yellMinimumLevel = 2
yellAlwaysAllowPremium = false

-- Server Save
-- NOTE: serverSaveNotifyDuration in minutes
serverSaveNotifyMessage = true
serverSaveNotifyDuration = 5
serverSaveCleanMap = false
serverSaveClose = true
serverSaveShutdown = true

-- Experience stages
-- NOTE: to use a flat experience multiplier, set experienceStages to nil
-- minlevel and multiplier are MANDATORY
-- maxlevel is OPTIONAL, but is considered infinite by default
-- to disable stages, create a stage with minlevel 1 and no maxlevel
experienceStages = {
	{ minlevel = 1, maxlevel = 8, multiplier = 7 },
	{ minlevel = 9, maxlevel = 20, multiplier = 6 },
	{ minlevel = 21, maxlevel = 50, multiplier = 5 },
	{ minlevel = 51, maxlevel = 100, multiplier = 4 },
	{ minlevel = 101, maxlevel = 509, multiplier = 3 },
	{ minlevel = 510, multiplier = 0 }
}

-- Skill stages
-- NOTE: to use a flat skill multiplier, set skillStages to nil
-- minskill and multiplier are MANDATORY
-- maxskill is OPTIONAL, but is considered infinite by default
-- to disable stages, create a stage with minskill 1 and no maxskill
skillStages = {
	{ minskill = 1, maxskill = 30, multiplier = 100 },
	{ minskill = 31, maxskill = 40, multiplier = 98 },
	{ minskill = 41, maxskill = 50, multiplier = 83 },
	{ minskill = 51, maxskill = 60, multiplier = 68 },
	{ minskill = 61, maxskill = 70, multiplier = 60 },
	{ minskill = 71, maxskill = 80, multiplier = 38 },
	{ minskill = 81, maxskill = 90, multiplier = 23 },
	{ minskill = 90, maxskill = 100, multiplier = 15 },
	{ minskill = 101, maxskill = 110, multiplier = 3 },
	{ minskill = 111, maxskill = 254, multiplier = 1 },
	{ minskill = 255, multiplier = 0 }
}

-- Magic Level stages
-- NOTE: to use a flat magic level multiplier, set magicLevelStages to nil
-- minmagic and multiplier are MANDATORY
-- maxmagic is OPTIONAL, but is considered infinite by default
-- to disable stages, create a stage with minmagic 0 and no maxmagic
magicLevelStages = {
	{ minmagic = 0, maxmagic = 50, multiplier = 38 },
	{ minmagic = 51, maxmagic = 70, multiplier = 35 },
	{ minmagic = 71, maxmagic = 80, multiplier = 23 },
	{ minmagic = 81, maxmagic = 100, multiplier = 15 },
	{ minmagic = 101, maxmagic = 110, multiplier = 3 },
	{ minmagic = 111, multiplier = 1 }
}

-- Rates
-- NOTE: rateExp is NOT USED because experienceStages is enabled above
-- NOTE: rateSkill is NOT USED because skillStages is enabled above
-- NOTE: rateMagic is NOT USED because magicLevelStages is enabled above
rateExp = 1
rateSkill = 1
rateLoot = 5
rateMagic = 1
rateSpawn = 2
spawnSpeed = 2.0

-- Monster rates
rateMonsterHealth = 1.0
rateMonsterAttack = 1.2
rateMonsterDefense = 1.0
rateMonsterSpeed = 1.95

-- Today regeneration condition over an loop every 1 second,
-- So values which should regenerated less then 1 second or won't will work
rateHealthRegen = 1.0
rateHealthRegenSpeed = 1.0
rateManaRegen = 1.0
rateManaRegenSpeed = 1.0
rateSoulRegen = 1.0
rateSoulRegenSpeed = 1.0
rateAttackSpeed = 1.0

-- Monsters
deSpawnRange = 2
deSpawnRadius = 50

-- Stamina
staminaSystem = true

-- Player Look Settings
showKillsDeathsOnLook = true

-- Scripts
warnUnsafeScripts = true
convertUnsafeScripts = true

-- Startup
